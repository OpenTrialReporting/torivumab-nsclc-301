# qc/.env — local Pinnacle 21 CLI config for qc/run_p21.sh
# Copy to qc/.env and fill in for your machine. qc/.env is git-ignored.
# Anything already exported in your shell environment overrides these.

# Directory holding p21-client-*.jar and the configs/ folder (the Community
# "Documents" install dir). If unset, the script tries:
#   $HOME/OneDrive/Documents/Pinnacle 21 Community  then
#   $HOME/Documents/Pinnacle 21 Community
#P21_HOME="/c/Users/<you>/OneDrive/Documents/Pinnacle 21 Community"

# Bundled Java 8 (Community ships it). Default points at the standard install.
#P21_JAVA="/c/Program Files (x86)/Pinnacle 21 Community/resources/app.asar.unpacked/components/java64/bin/java.exe"

# Engine/config version and CDISC SDTM CT version (defaults shown).
#P21_ENGINE="2508.1"
#P21_CT="2026-03-27"

# Optional Pinnacle 21 Enterprise API key — a real credential; keep it here,
# never in the committed script. Leave blank for Community/local validation.
#P21_API_KEY=""
